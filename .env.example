# =============================================================================
# SETU API - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# =============================================================================

# Application Settings
APP_NAME=SETU API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# CORS Configuration
# Provide comma-separated origins or a JSON list of allowed origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server Settings (Local Development)
HOST=127.0.0.1
PORT=8000

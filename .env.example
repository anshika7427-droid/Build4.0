# =============================================================================
# SETU — Root Environment Variables Template
# =============================================================================
# Copy this file to .env and replace all placeholder values.
#
# NEVER commit real credentials to .env files.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# TinyFish web context
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Runtime Environment
ENVIRONMENT=development

# Auth & JWT Configuration (Must be distinct 32+ character secrets in production)
SECRET_TOKEN=change_me_use_a_long_random_string
JWT_SECRET=change_me_use_a_separate_long_random_string
